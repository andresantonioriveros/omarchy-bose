{
  "schemaVersion": 1,
  "id": "io.github.andresariveros.omabose",
  "name": "Bose",
  "version": "0.3.2",
  "author": "Andres Riveros",
  "license": "MIT",
  "description": "Bose QuietComfort battery, mode, noise-control, and equalizer panel",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Bose",
    "description": "Bose QuietComfort battery, mode, noise-control, and equalizer panel",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "hideWhenDisconnected": true,
      "pollIntervalSec": 15
    },
    "schema": [
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide when disconnected",
        "defaultValue": true
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Status refresh (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
